        { "symbol": "AMZN", "yahoo": "AMZN", "nameZh": "亞馬遜", "nameEn": "Amazon", "theme": "Kuiper 衛星寬頻", "outlookTone": "positive", "note": "Kuiper對打星鏈；Capex極高但有AWS", "outlook": "亞馬遜的 Project Kuiper 要做大型 LEO 寬頻星座，直接對標 Starlink。前景不在「會不會發射」，而在能否用 AWS、零售與廣告現金流把星座燒出來，再把連線賣給企業與政府。風險是資本支出巨大、進度落後星鏈。對亞馬遜整體仍是選項，不是本業；對太空產業則是少數有能力真的把星座建完的玩家。" },
        { "symbol": "SPCE", "yahoo": "SPCE", "nameZh": "維珍銀河", "nameEn": "Virgin Galactic", "theme": "太空觀光", "outlookTone": "cautious", "note": "觀光飛行節奏慢；現金消耗高", "outlook": "維珍銀河做亞軌道太空觀光，故事明確、商業化卻很慢，飛行節奏與現金消耗是核心問題。若新機型能量產，門票收入才有機會規模化；在那之前更像選擇權。前景宜審慎，比較適合理解題材，不適合當成太空產業的主要代表。" }
